# SWITCHYARD Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# DO NOT COMMIT SENSITIVE PASSWORDS OR AWS KEYS TO SOURCE CONTROL.

# Application Environment
SWITCHYARD_ENV=development
SWITCHYARD_LOG_LEVEL=INFO

# Operational Database (Serving Layer)
# For local development, SQLite file or local PostgreSQL:
# Examples:
# DATABASE_URL=sqlite:///./switchyard_operational.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/switchyard
DATABASE_URL=sqlite:///./switchyard_operational.db

# Data Lake Local Paths
DATA_RAW_DIR=./data/generated
DATA_PROCESSED_DIR=./data/processed
DATA_REJECTED_DIR=./data/rejected
DATA_SAMPLE_DIR=./data/sample

# Prioritization Rule Weights (Must sum to 1.0)
WEIGHT_SLA_RISK=0.35
WEIGHT_CUSTOMER_IMPACT=0.25
WEIGHT_FINANCIAL_IMPACT=0.20
WEIGHT_CASE_AGE=0.10
WEIGHT_OPERATIONAL_CRITICALITY=0.10

# SLA Thresholds
SLA_WARNING_THRESHOLD_RATIO=0.80
SLA_BREACH_THRESHOLD_RATIO=1.00

# AWS Cloud Integration (Required only when running in AWS mode)
AWS_REGION=us-east-1
AWS_S3_BUCKET=switchyard-operational-lakehouse
AWS_GLUE_DATABASE=switchyard_analytics
AWS_ATHENA_WORKGROUP=primary
AWS_ATHENA_OUTPUT_LOCATION=s3://switchyard-operational-lakehouse/athena-results/
